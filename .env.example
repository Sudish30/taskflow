# Copy to .env and adjust as needed. Every value has a working default,
# so this file is optional for local development.

TASKFLOW_APP_NAME=TaskFlow
TASKFLOW_DATABASE_URL=sqlite:///./taskflow.db
TASKFLOW_SECRET_KEY=dev-secret-key-change-in-production
TASKFLOW_ALGORITHM=HS256
TASKFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to false to disable per-request logging
TASKFLOW_REQUEST_LOG_ENABLED=true
